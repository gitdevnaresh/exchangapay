# This `.xcode.env` file is versioned and is used to source the environment
# used when running script phases inside Xcode.
# To customize your local environment, you can create an `.xcode.env.local`
# file that is not versioned.

# Xcode runs build script phases in a non-interactive shell that does NOT source
# ~/.zshrc or ~/.bash_profile. Version managers (nvm, fnm, volta, asdf) install
# their shims there, so a bare `command -v node` finds nothing and the build
# fails with "node: No such file or directory". Resolve node explicitly here so
# the project builds on a fresh clone on any machine without local edits.

if [ -z "$NODE_BINARY" ]; then
  # nvm — respects .nvmrc if the project has one, else the default alias
  export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
  if [ -s "$NVM_DIR/nvm.sh" ]; then
    . "$NVM_DIR/nvm.sh" --no-use
    nvm use --silent >/dev/null 2>&1 || nvm use default --silent >/dev/null 2>&1
  elif command -v brew >/dev/null 2>&1 && [ -s "$(brew --prefix nvm 2>/dev/null)/nvm.sh" ]; then
    . "$(brew --prefix nvm)/nvm.sh" --no-use
    nvm use --silent >/dev/null 2>&1 || nvm use default --silent >/dev/null 2>&1
  fi

  # Prefer whatever nvm just put on PATH
  NODE_BINARY=$(command -v node)

  # Otherwise fall back to fnm / volta / asdf shims and standard install paths
  if [ -z "$NODE_BINARY" ]; then
    for candidate in \
      "$HOME/.volta/bin/node" \
      "$HOME/.asdf/shims/node" \
      /opt/homebrew/bin/node \
      /usr/local/bin/node \
      /usr/bin/node
    do
      if [ -x "$candidate" ]; then
        NODE_BINARY="$candidate"
        break
      fi
    done
  fi
fi

export NODE_BINARY
