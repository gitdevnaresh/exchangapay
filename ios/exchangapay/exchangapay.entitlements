<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	Entitlements for BOTH Debug and Release — H-07 / M-07 / M-13.

	One file, not one per configuration. aps-environment is the only entitlement
	that must differ between Debug and Release, so it comes from the
	APS_ENVIRONMENT build setting (Target > Build Settings > User-Defined):

	  Debug    APS_ENVIRONMENT = development
	  Release  APS_ENVIRONMENT = production

	Everything else is shared, so an entitlement cannot exist in Debug and be
	discovered missing in production. The [H-07] Release build phase and the
	C-01 Gradle guard both assert that Release resolves to `production`.
-->
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>$(APS_ENVIRONMENT)</string>

	<!--
		M-07: Universal Links for the OAuth callback. Both tenants listed — iOS
		ignores an applinks domain that does not resolve for this app, so an
		unmatched entry is inert rather than an error.

		Requires Associated Domains on the App ID and regenerated provisioning
		profiles, or signing fails.
	-->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:exchangapay.eu.auth0.com</string>
		<string>applinks:exchangapay-tst.eu.auth0.com</string>
	</array>

	<!--
		L-14: every file the app writes (AsyncStorage, react-native-fs, caches)
		is encrypted with a key that is discarded while the device is locked.
		Side effect: the FCM background handler in index.js cannot write
		AsyncStorage while locked; its try/catch absorbs that.

		Requires Data Protection on the App ID and regenerated provisioning
		profiles, or signing fails.

		TEMPORARILY REMOVED: the team cannot regenerate profiles until the
		Account Holder accepts the latest Apple Program License Agreement, so
		every device build failed with "profile doesn't include the Data
		Protection capability". L-14 is OPEN until this is restored. To restore:
		enable Data Protection (Complete) on com.exchangapay.tst and
		com.exchangapay, then add back:

		<key>com.apple.developer.default-data-protection</key>
		<string>NSFileProtectionComplete</string>
	-->
</dict>
</plist>
