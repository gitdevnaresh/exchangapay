+     * Upstream's getPromptInfo drops the credential fallback entirely there:
+     * getAllowedAuthenticators returns bare BIOMETRIC_STRONG whenever
+     * isCurrentSDK29OrEarlier(), so on Android 10 "allowDeviceCredentials: true"
+     * is silently a no-op. setDeviceCredentialAllowed is deprecated but is the
+     * only route to the PIN below API 30, and it cannot be combined with
+     * setAllowedAuthenticators or with a negative button.
+     */
+    private PromptInfo getPresencePromptInfo(String promptMessage, String cancelButtonText, boolean allowDeviceCredentials) {
+        PromptInfo.Builder builder = new PromptInfo.Builder().setTitle(promptMessage);
+
+        if (allowDeviceCredentials && isCurrentSDK29OrEarlier()) {
+            builder.setDeviceCredentialAllowed(true);
+            return builder.build();
+        }
