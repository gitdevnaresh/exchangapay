+    /**
+     * Authenticators acceptable for a PRESENCE check (isSensorAvailable, simplePrompt).
+     *
+     * Upstream only ever asks for BIOMETRIC_STRONG. Class 2 (BIOMETRIC_WEAK)
+     * sensors are common on mid-range Android — the Redmi Note 7 Pro is one —
+     * and on those canAuthenticate(BIOMETRIC_STRONG) answers NO_HARDWARE even
+     * with a finger enrolled. The app then concludes the device cannot verify
+     * its owner and locks the user out of their own app.
+     *
+     * Class 2 is the right bar for "is the owner holding this handset". It is
+     * NOT the right bar for a CryptoObject — Keystore requires Class 3, and
+     * pairing WEAK with a CryptoObject throws. createSignature therefore keeps
+     * using getAllowedAuthenticators() above; only these two paths widen.
+     */
+    private int getPresenceAuthenticators(boolean allowDeviceCredentials) {
+        BiometricManager biometricManager = BiometricManager.from(getReactApplicationContext());
+
+        if (allowDeviceCredentials && !isCurrentSDK29OrEarlier()) {
+            int strong = BiometricManager.Authenticators.BIOMETRIC_STRONG | BiometricManager.Authenticators.DEVICE_CREDENTIAL;
+            if (biometricManager.canAuthenticate(strong) == BiometricManager.BIOMETRIC_SUCCESS) {
+                return strong;
+            }
+            int weak = BiometricManager.Authenticators.BIOMETRIC_WEAK | BiometricManager.Authenticators.DEVICE_CREDENTIAL;
+            if (biometricManager.canAuthenticate(weak) == BiometricManager.BIOMETRIC_SUCCESS) {
+                return weak;
+            }
+            return strong;
+        }
+
+        if (biometricManager.canAuthenticate(BiometricManager.Authenticators.BIOMETRIC_STRONG) == BiometricManager.BIOMETRIC_SUCCESS) {
+            return BiometricManager.Authenticators.BIOMETRIC_STRONG;
+        }
+        if (biometricManager.canAuthenticate(BiometricManager.Authenticators.BIOMETRIC_WEAK) == BiometricManager.BIOMETRIC_SUCCESS) {
+            return BiometricManager.Authenticators.BIOMETRIC_WEAK;
+        }
+        return BiometricManager.Authenticators.BIOMETRIC_STRONG;
+    }
