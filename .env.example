# Copy to .env and fill in values, or run: npm run env:tst / env:prod / env:dev
# .env and .env.prod are gitignored. .env.tst and .env.dev are committed (no secrets).

APP_ENV=                        # dev | tst | prod

AUTH0_ISSUER=
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=
AUTH0_SCOPE=openid profile email enroll offline_access

UPLOAD_URL=
CARDS_URL=
WALLET_GRID_URL=
BANK_URL=
WALLET_API_URL=
AUTH_URL=
MARKET_URL=

SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_SEND_PII=false
SENTRY_ENABLE_LOGS=false
SENTRY_REPLAYS_SESSION_RATE=0
SENTRY_REPLAYS_ERROR_RATE=0

PLAY_INTEGRITY_CLOUD_PROJECT=

ANDROID_APPLICATION_ID=
ANDROID_AUTH0_DOMAIN=
IOS_BUNDLE_ID=
IOS_AUTH0_DOMAIN=

DEFAULT_RESOURCE_NAME=Exchanga Pay
